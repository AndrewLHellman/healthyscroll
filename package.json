{
  "name": "healthyscroll",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome extension that skips short-form videos which don't align with your goals, using Jev for decisions and Moondream for on-device vision.",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:extension": "pnpm --filter @healthyscroll/extension dev",
    "dev:safari": "pnpm --filter @healthyscroll/extension dev:safari",
    "dev:web": "pnpm --filter @healthyscroll/web dev",
    "build": "pnpm -r build",
    "build:safari": "pnpm --filter @healthyscroll/extension build:safari",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
