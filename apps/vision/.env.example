# Copy to apps/vision/.env

# The VLM that describes each Reel (key of REGISTRY in vision/scorers/__init__.py);
# the extension sends the description to Jev, which decides. qwen3-vl-2b needs a
# GPU; gemini-2.5-flash-lite goes through the AI Gateway (the free tier's model).
VISION_CAPTIONER=qwen3-vl-2b
# 4-bit language model for small GPUs (4 GB laptop cards). Set false on a server GPU.
VISION_QUANTIZE=true

# Frame sampling: one every N seconds from 0.5 s, capped. Poster is added as frame 0.
VISION_FRAME_EVERY_S=3
VISION_MAX_FRAMES=3

# Per-user requests/minute (prefetch sends one per upcoming Reel).
VISION_RATE_PER_MIN=120

# Supabase (same project as the extension/web). Anon key is public.
SUPABASE_URL=https://ikwvesahfsjpwdnwdfos.supabase.co
SUPABASE_ANON_KEY=
# Set false only for local testing without a signed-in user.
VISION_REQUIRE_AUTH=true

# Vercel AI Gateway key, for the gemini-* scorers/captioners.
AI_GATEWAY_API_KEY=

# Optional: path to ffmpeg if it isn't on PATH.
# FFMPEG_PATH=

# ElevenLabs speech-to-text: the last-resort audio pass (POST /transcribe), only for
# Reels on screen that text + description left Jev unsure about. Billed per second of
# audio ($0.22/hour on Scribe v2). No key -> /transcribe answers 503 and nothing breaks.
# Use a key restricted to Speech to Text, with a credit limit set in the ElevenLabs dashboard.
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# Seconds of audio sent per Reel, from the start.
TRANSCRIBE_MAX_S=30
# New transcriptions (cache hits are free) per user per UTC day, and across everyone.
TRANSCRIBE_PER_USER_DAY=50
TRANSCRIBE_DAILY_MAX=1000
