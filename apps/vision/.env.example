# Copy to apps/vision/.env

# Fast per-user scorer (key of REGISTRY in vision/scorers/__init__.py).
# siglip2-base: frame embeddings cached per Reel, per-user score <1 ms.
VISION_MODEL=siglip2-base
# Writes a per-Reel description when the fast score is "uncertain"; the client
# sends it to Jev. qwen3-vl-2b (local GPU), gemini-3.5-flash-lite (gateway), or none.
VISION_CAPTIONER=qwen3-vl-2b
# 4-bit language model for small GPUs (4 GB laptop cards). Set false on a server GPU.
VISION_QUANTIZE=true

# Frame sampling: one every N seconds from 0.5 s, capped. Poster is added as frame 0.
VISION_FRAME_EVERY_S=2
VISION_MAX_FRAMES=8

# Optional: override the model's own thresholds (see Spec). Calibrate with bench/.
# VISION_SKIP_THRESHOLD=
# VISION_ALLOW_THRESHOLD=

# Per-user requests/minute (prefetch sends one per upcoming Reel).
VISION_RATE_PER_MIN=120

# Supabase (same project as the extension/web). Anon key is public.
SUPABASE_URL=https://ikwvesahfsjpwdnwdfos.supabase.co
SUPABASE_ANON_KEY=
# Set false only for local testing without a signed-in user.
VISION_REQUIRE_AUTH=true

# Vercel AI Gateway key, for the gemini-* scorers/captioners.
AI_GATEWAY_API_KEY=

# Optional: path to ffmpeg if it isn't on PATH.
# FFMPEG_PATH=
