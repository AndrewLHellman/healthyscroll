# Set to "true" to start the TikTok observer in the content script. Off by default
# while the pipeline is being built so loading the extension is inert.
VITE_HS_ENABLE_CONTENT=false

# Set to "true" to log scrapes/decisions to the tiktok.com console and enable the
# console hooks: dispatchEvent(new Event("hs:probe")) and dispatchEvent(new Event("hs:skip")).
VITE_HS_DEBUG=false

# Override where the extension sends requests (defaults: localhost in `vite` dev,
# healthyscroll.net / vision.healthyscroll.net in `vite build`). For a local build:
#   VITE_API_BASE_URL=http://localhost:3000
#   VITE_VISION_URL=http://localhost:8000
VITE_API_BASE_URL=
VITE_VISION_URL=
