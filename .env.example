# Copy to apps/web/.env.local
# Vercel AI Gateway key — used by the Next.js API route to call Jev (typesafe-ai/jev).
# Get one at https://vercel.com/ai-gateway. Never ship this in the extension.
AI_GATEWAY_API_KEY=

# Optional: Moondream Cloud key for a server-side fallback when Moondream Station
# isn't running on the user's machine. https://moondream.ai/c/cloud/api-keys
MOONDREAM_API_KEY=

# Optional: make the landing page's prompt playground score its mock feed with
# real Jev via /api/evaluate (needs AI_GATEWAY_API_KEY above). Default is a
# keyword lookup in the browser. Each edit = 8 text-only Jev calls.
# NEXT_PUBLIC_PLAYGROUND_SCORER=jev

# Jev call timeout (ms). A late verdict is useless; the extension leaves the Reel alone on error.
# JEV_TIMEOUT_MS=4000
# Zero data retention on the gateway (default true). With it on, Jev can only use the
# typesafe-ai provider; set false to also allow others when that one is overloaded (429s).
# JEV_ZERO_DATA_RETENTION=true
